{
  "name": "قالب سفارشی نمونه",
  "description": "نمونه فایل مشخصات محاسبات برای قالب سفارشی — ستون‌ها مطابق فایل داده نمونه (sample-sales-data) تنظیم شده‌اند؛ برای داده خودتان نام ستون‌ها را تغییر دهید.",
  "kpiIds": ["total_revenue", "count_rows", "avg_order"],
  "calcSpec": [
    { "id": "total_revenue", "label": "مجموع مبلغ کل", "op": "sum", "column": "مبلغ کل (تومان)" },
    { "id": "count_rows", "label": "تعداد سفارش‌ها", "op": "count" },
    { "id": "avg_order", "label": "میانگین مبلغ سفارش", "op": "mean", "column": "مبلغ کل (تومان)" },
    { "id": "by_city", "label": "فروش به تفکیک شهر", "op": "groupSum", "column": "مبلغ کل (تومان)", "groupBy": "شهر" },
    { "id": "by_category", "label": "فروش به تفکیک دسته محصول", "op": "groupSum", "column": "مبلغ کل (تومان)", "groupBy": "دسته محصول" },
    { "id": "monthly_trend", "label": "روند ماهانه فروش", "op": "periodCompare", "column": "مبلغ کل (تومان)", "dateColumn": "تاریخ سفارش", "grain": "month" },
    { "id": "delivered_pct", "label": "درصد سفارش‌های تحویل‌شده", "op": "pctFiltered", "column": "وضعیت سفارش", "filter": { "op": "eq", "value": "تحویل شده" } }
  ]
}
